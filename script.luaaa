-- ====== TOF UI ======
ToFBox:AddToggle("ToFAimToggle", {
    Text = "Silent Aim Twist of Fate", Default = false,
    Callback = function(v)
        if getgenv().KYS_SetToFSilentAim then
            getgenv().KYS_SetToFSilentAim(v)
        else
            ToFAimConfig.Enabled = v
        end
    end
})
ToFBox:AddDropdown("ToFAimTarget", {
    Values = {"Killer", "Survivors", "Zombie"}, Default = 1, Text = "Target Mode",
    Callback = function(v)
        if type(v) == "table" then v = v[1] end
        if getgenv().KYS_ToFSetTargetMode then
            getgenv().KYS_ToFSetTargetMode(v or "Killer", false)
        else
            ToFAimConfig.TargetMode = v or "Killer"
        end
    end
})
ToFBox:AddToggle("ToFAimPredict", {
    Text = "Aim Prediction", Default = true,
    Callback = function(v) ToFAimConfig.Predict = v end
})
ToFBox:AddToggle("ToFAimLaser", {
    Text = "Show Laser", Default = true,
    Callback = function(v)
        ToFAimConfig.Laser = v
        if not v and getgenv().KYS_ToFClearLaser then
            getgenv().KYS_ToFClearLaser()
        end
    end
})
ToFBox:AddToggle("ToFAimWallCheck", {
    Text = "Wall Check", Default = false,
    Callback = function(v) ToFAimConfig.WallCheck = v end
})
ToFBox:AddToggle("ToFAimBlockKnocked", {
    Text = "Block When Knocked", Default = true,
    Callback = function(v) ToFAimConfig.BlockWhenKnocked = v end
})
ToFBox:AddSlider("ToFPredictSpeed", {
    Text = "Predict Bullet Speed", Default = 400, Min = 100, Max = 1500, Rounding = 0,
    Callback = function(v) ToFAimConfig.BulletSpeed = v end
})
ToFBox:AddSlider("ToFVerticalDot", {
    Text = "Vertical Dot (Survivor/Zombie)", Default = 0.5, Min = -1, Max = 1, Rounding = 2,
    Callback = function(v) ToFAimConfig.VerticalDot = v end
})
ToFBox:AddDropdown("ToFKeybind", {
    Values = {"None","Q","E","R","T","F","G","H","J","K","L","X","Z"},
    Default = 1, Text = "Toggle Key",
    Callback = function(v) 
        if type(v) == "table" then v = v[1] end
        ToFAimConfig.Keybind = v or "None"
    end
})

-- MOVEMENT UI
MovementBox:AddCheckbox("WalkSpeedToggle", {
    Text = "Walk Speed", Default = false,
    Callback = function(v)
        Movement.WalkSpeedEnabled = v
        if v then 
            applyWalkSpeed()
        else
            local char = LocalPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hum then 
                hum.WalkSpeed = Movement.OriginalWalkSpeed 
            end
        end
    end
})
MovementBox:AddButton({
    Text = "Fly GUI",
    Func = function()
        local found = false
        for _, v in pairs(game.CoreGui:GetChildren()) do
            if v.Name:lower():find("fly") then found = true end
        end
        if not found then
            loadstring(game:HttpGet("https://raw.githubusercontent.com/XNEOFF/FlyGuiV3/main/FlyGuiV3.txt"))()
            Library:Notify({ Title = "Fly", Description = "Fly GUI Dimuat", Time = 3 })
        else
            Library:Notify({ Title = "Fly", Description = "Fly GUI terbuka", Time = 3 })
        end
    end
})

MovementBox:AddSlider("WalkSpeedSlider", {
    Text = "Walk Speed Value", 
    Default = 1000,
    Min = 16,
    Max = 1000,
    Rounding = 1,
    Callback = function(v) 
        Movement.WalkSpeedValue = v
        if Movement.WalkSpeedEnabled then 
            applyWalkSpeed() 
        end 
    end
})
MovementBox:AddCheckbox("NoClipToggle", {
    Text = "No Clip", Default = false,
    Callback = function(v) toggleNoClip(v) end
})
MovementBox:AddCheckbox("JumpPowerToggle", {
    Text = "Custom Jump Power", Default = false,
    Callback = function(v)
        Movement.JumpPowerEnabled = v
        if v then applyJumpPower()
        else
            local char = LocalPlayer.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.JumpPower = Movement.OriginalJumpPower end
        end
    end
})
MovementBox:AddSlider("JumpPowerSlider", {
    Text = "Jump Power Value", Default = 50, Min = 0, Max = 300, Rounding = 0,
    Callback = function(v) Movement.JumpPowerValue = v; if Movement.JumpPowerEnabled then applyJumpPower() end end
})

FunBox:AddToggle("FakeTagEnabled", {
    Text = "Enable Fake Tag",
    Default = FakeTag.Enabled,
    Callback = function(Value)
        FakeTag.Enabled = Value
    end
})

FunBox:AddInput("FakeTagText", {
    Default = FakeTag.Text,
    Numeric = false,
    Finished = true,
    Text = "Chat Tag",
    Placeholder = "[Kanzyu_script]",
    Callback = function(Value)
        if Value ~= "" then
            FakeTag.Text = Value
        end
    end
})

